# Local dev: use direct connection (port 5432)
# Production (Supabase + Vercel): use pooled connection (port 6543) with ?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://postgres:password@localhost:5432/lat_dev

NEXTAUTH_SECRET=                 # openssl rand -base64 32

GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=              # Gmail App Password — Google Account → Security → 2-Step Verification → App Passwords

ADMIN_EMAIL=admin@lasu.edu.ng
ADMIN_PASSWORD_HASH=             # node -e "const b=require('bcryptjs');b.hash('yourpassword',10).then(console.log)"

CRON_SECRET=                     # openssl rand -base64 32
