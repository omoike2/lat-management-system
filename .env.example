# Runtime connection — pooled (port 6543) for Vercel/serverless, direct (port 5432) for local dev
DATABASE_URL=postgresql://postgres:password@localhost:5432/lat_dev

# Direct connection — required for db:push and db:seed (pgbouncer doesn't support schema ops)
# Supabase format: postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
# Local: same as DATABASE_URL
DIRECT_URL=postgresql://postgres:password@localhost:5432/lat_dev

NEXTAUTH_SECRET=                 # openssl rand -base64 32

GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=              # Gmail App Password — Google Account → Security → 2-Step Verification → App Passwords

ADMIN_EMAIL=admin@lasu.edu.ng
ADMIN_PASSWORD_HASH=             # node -e "const b=require('bcryptjs');b.hash('yourpassword',10).then(console.log)"

CRON_SECRET=                     # openssl rand -base64 32
SITE_ENABLED=true
